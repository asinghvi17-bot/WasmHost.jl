{
  "name": "@wasmhost/node",
  "version": "0.2.0",
  "private": true,
  "description": "Node adapter of WasmHost.jl: downloads (fetch), decompression (node:zlib) and platform tags for WASI modules compiled by WasmCodegen.jl. Not published yet.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24", "bun": ">=1.4" },
  "exports": {
    ".": "./index.mjs",
    "./spool": "./spool.mjs",
    "./imports": "./imports.mjs",
    "./platform": "./platform.mjs",
    "./page": "./page.mjs"
  },
  "wasmhost": {
    "transports": ["spool", "import"],
    "waiting": ["jspi", "sync"],
    "capabilities": { "downloads": "spool, import", "decompress": "spool: gzip, deflate, zstd", "platform": "WASI env", "page": "wasm_host_page" },
    "tested": true
  }
}
